generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PlatformTrack {
  id              String @id @default(uuid())
  trackId         String
  platformName    String
  platformTrackId String

  track Track @relation(fields: [trackId], references: [id])

  @@unique([platformName, platformTrackId])
}

model ListeningHistory {
  id           String   @id @default(uuid())
  userId       String
  platformName String
  trackId      String
  playedAt     DateTime
  source       String
  uploadedAt   DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId, playedAt])
  @@index([userId, playedAt])
}

model Track {
  id              String @id @default(uuid())
  trackName       String
  albumName       String
  durationMs      Int
  metadata        Json?
  isrc            String? @unique
  platformTracks  PlatformTrack[]
  listeningHistory ListeningHistory[]
  artists         Artist[] @relation("TrackArtists")
}

model PlatformArtist {
  id                String @id @default(uuid())
  artistId          String
  platformName      String
  platformArtistId  String

  artist Artist @relation(fields: [artistId], references: [id])

  @@unique([platformArtistId, platformName])
}

model Artist {
  id              String   @id @default(uuid())
  name            String
  imageUrl        String?
  genres          String[] @default([])

  tracks          Track[] @relation("TrackArtists")
  platformArtists PlatformArtist[]
}

model User {
  id           String   @id @default(uuid())
  displayName  String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  listeningHistory   ListeningHistory[]
  internalSessions   InternalAuthSessions[]
  connectedPlatforms ConnectedPlatforms[]
  exclusions         Exclusion[]
}

model InternalAuthSessions {
  id           String   @id @default(uuid())
  userId       String   @unique
  RefreshToken String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model ConnectedPlatforms {
  id             String   @id @default(uuid())
  userId         String
  platformName   String
  platformUserId String
  accessToken    String   @map("AccessToken")
  refreshToken   String   @map("RefreshToken")
  expiresAt      DateTime
  connectedAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platformName])
}

model Exclusion {
  id         String   @id @default(cuid())
  userId     String
  type       String
  targetId   String
  name       String
  artistName  String?
  albumName  String?
  excludedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, type, targetId])
  @@index([userId])
}